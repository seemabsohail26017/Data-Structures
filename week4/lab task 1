#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* next;
};

void display(Node* head)
{
    if (head == NULL)
        return;

    Node* p = head;

    do
    {
        cout << p->data << " ";
        p = p->next;
    }
    while (p != head);
}

void deleteEvenNodes(Node*& head)
{
    if (head == NULL)
        return;

    Node* p = head;
    Node* prev = NULL;

    do
    {
        if (p->data % 2 == 0)
        {
            // Only one node
            if (p->next == p)
            {
                delete p;
                head = NULL;
                return;
            }

            // Delete first node
            if (p == head)
            {
                Node* last = head;

                while (last->next != head)
                    last = last->next;

                head = head->next;
                last->next = head;

                delete p;
                p = head;
            }
            else
            {
                prev->next = p->next;

                Node* temp = p;
                p = p->next;

                delete temp;
            }
        }
        else
        {
            prev = p;
            p = p->next;
        }

    }
    while (p != head);
}

int main()
{
    Node* head = NULL;
    Node* last = NULL;

    int n, data;

    cout << "Enter number of nodes: ";
    cin >> n;

    for (int i = 0; i < n; i++)
    {
        cin >> data;

        Node* p = new Node;
        p->data = data;

        if (head == NULL)
        {
            head = p;
            last = p;
            p->next = head;
        }
        else
        {
            p->next = head;
            last->next = p;
            last = p;
        }
    }

    cout << "Original List: ";
    display(head);

    deleteEvenNodes(head);

    cout << "\nAfter deleting even nodes: ";
    display(head);

    return 0;
}
