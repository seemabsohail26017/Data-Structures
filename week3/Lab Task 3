#include <iostream>
using namespace std;

struct SNode
{
    int data;
    SNode* next;
};

struct DNode
{
    int data;
    DNode* prev;
    DNode* next;
};

DNode* convertToDoubly(SNode* head)
{
    if (head == NULL)
        return NULL;

    DNode* dHead = NULL;
    DNode* dTail = NULL;

    SNode* current = head;

    while (current != NULL)
    {
        DNode* newNode = new DNode;

        newNode->data = current->data;
        newNode->prev = NULL;
        newNode->next = NULL;

        if (dHead == NULL)
        {
            dHead = newNode;
            dTail = newNode;
        }
        else
        {
            dTail->next = newNode;
            newNode->prev = dTail;
            dTail = newNode;
        }

        current = current->next;
    }

    return dHead;
}

void display(SNode* head)
{
    SNode* current = head;

    while (current != NULL)
    {
        cout << current->data << " ";
        current = current->next;
    }
}

void displayDoubly(DNode* head)
{
    DNode* current = head;

    while (current != NULL)
    {
        cout << current->data << " ";
        current = current->next;
    }
}

int main()
{
    // Singly linked list
    SNode* head = new SNode{10, NULL};

    head->next = new SNode{20, NULL};
    head->next->next = new SNode{30, NULL};
    head->next->next->next = new SNode{40, NULL};

    cout << "Singly Linked List: ";
    display(head);

    // Convert
    DNode* dHead = convertToDoubly(head);

    cout << "\nDoubly Linked List: ";
    displayDoubly(dHead);

    return 0;
}
