#include <iostream>
#include <stack>
using namespace std;

int applyOp(int a, int b, char op) {
    switch(op) {
        case '+': return a+b;
        case '-': return a-b;
        case '*': return a*b;
        case '/': return a/b;
    }
    return 0;
}

int evaluatePostfix(string postfix) {
    stack<int> s;
    for(char ch : postfix) {
        if(isdigit(ch)) {
            s.push(ch - '0'); // convert char to int
        } else {
            int b = s.top(); s.pop();
            int a = s.top(); s.pop();
            s.push(applyOp(a, b, ch));
        }
    }
    return s.top();
}

int main() {
    string postfix;
    cout << "Enter postfix expression (digits only): ";
    cin >> postfix;
    cout << "Result: " << evaluatePostfix(postfix) << endl;
}
