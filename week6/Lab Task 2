#include <iostream>
using namespace std;

// Node structure for doubly linked deque
struct Node {
    int data;
    Node* prev;
    Node* next;
};

class Deque {
    Node* front;
    Node* rear;
public:
    Deque() {
        front = rear = NULL;
    }

    bool is_empty() {
        return (front == NULL);
    }

    void insertFront(int x) {
        Node* temp = new Node;
        temp->data = x;
        temp->prev = NULL;
        temp->next = front;

        if (is_empty()) {
            front = rear = temp;
        } else {
            front->prev = temp;
            front = temp;
        }
        cout << "Inserted at front: " << x << endl;
    }

    void insertRear(int x) {
        Node* temp = new Node;
        temp->data = x;
        temp->next = NULL;
        temp->prev = rear;

        if (is_empty()) {
            front = rear = temp;
        } else {
            rear->next = temp;
            rear = temp;
        }
        cout << "Inserted at rear: " << x << endl;
    }

    void deleteFront() {
        if (is_empty()) {
            cout << "Deque is empty!" << endl;
            return;
        }
        Node* temp = front;
        cout << "Deleted from front: " << temp->data << endl;
        front = front->next;
        if (front != NULL) front->prev = NULL;
        else rear = NULL; // deque became empty
        delete temp;
    }

    void deleteRear() {
        if (is_empty()) {
            cout << "Deque is empty!" << endl;
            return;
        }
        Node* temp = rear;
        cout << "Deleted from rear: " << temp->data << endl;
        rear = rear->prev;
        if (rear != NULL) rear->next = NULL;
        else front = NULL; // deque became empty
        delete temp;
    }

    void display() {
        if (is_empty()) {
            cout << "Deque is empty!" << endl;
            return;
        }
        Node* temp = front;
        cout << "Deque elements: ";
        while (temp != NULL) {
            cout << temp->data << " ";
            temp = temp->next;
        }
        cout << endl;
    }
};

// Test in main
int main() {
    Deque dq;
    dq.insertFront(10);
    dq.insertRear(20);
    dq.insertFront(5);
    dq.display();

    dq.deleteFront();
    dq.deleteRear();
    dq.display();

    return 0;
}
