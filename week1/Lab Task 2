#include <iostream>
using namespace std;

class ArrayList
{
private:
    int arr[100];
    int size;

public:

    ArrayList()
    {
        size = 0;
    }

    // 1. Insert at end
    void insertEnd(int value)
    {
        arr[size] = value;
        size++;
    }

    // 2. Insert at start
    void insertStart(int value)
    {
        for (int i = size; i > 0; i--)
        {
            arr[i] = arr[i - 1];
        }

        arr[0] = value;
        size++;
    }

    // 3. Insert after specific value
    void insertAfter(int specific, int value)
    {
        for (int i = 0; i < size; i++)
        {
            if (arr[i] == specific)
            {
                for (int j = size; j > i + 1; j--)
                {
                    arr[j] = arr[j - 1];
                }

                arr[i + 1] = value;
                size++;
                return;
            }
        }

        cout << "Value not found." << endl;
    }

    // 4. Insert before specific value
    void insertBefore(int specific, int value)
    {
        for (int i = 0; i < size; i++)
        {
            if (arr[i] == specific)
            {
                for (int j = size; j > i; j--)
                {
                    arr[j] = arr[j - 1];
                }

                arr[i] = value;
                size++;
                return;
            }
        }

        cout << "Value not found." << endl;
    }

    // 5. Display
    void display()
    {
        for (int i = 0; i < size; i++)
        {
            cout << arr[i] << " ";
        }

        cout << endl;
    }

    // 6. Delete from end
    void deleteEnd()
    {
        if (size > 0)
        {
            size--;
        }
    }

    // 7. Delete from start
    void deleteStart()
    {
        if (size > 0)
        {
            for (int i = 0; i < size - 1; i++)
            {
                arr[i] = arr[i + 1];
            }

            size--;
        }
    }

    // 8. Delete specific value
    void deleteValue(int value)
    {
        for (int i = 0; i < size; i++)
        {
            if (arr[i] == value)
            {
                for (int j = i; j < size - 1; j++)
                {
                    arr[j] = arr[j + 1];
                }

                size--;
                return;
            }
        }

        cout << "Value not found." << endl;
    }
};

int main()
{
    ArrayList list;

    list.insertEnd(10);
    list.insertEnd(20);
    list.insertEnd(30);

    list.insertStart(5);

    list.insertAfter(20, 25);

    list.insertBefore(30, 28);

    cout << "Array List: ";
    list.display();

    list.deleteEnd();

    cout << "After deleting from end: ";
    list.display();

    list.deleteStart();

    cout << "After deleting from start: ";
    list.display();

    list.deleteValue(20);

    cout << "After deleting 20: ";
    list.display();

    return 0;
}
